# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API

# Public — safe to expose to the browser (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — NEVER prefix with NEXT_PUBLIC_, never log, never return to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── football-data.org ─────────────────────────────────────────────────────────
# Free tier at https://www.football-data.org — ~10 requests/minute
# SERVER ONLY — never expose to the browser
FOOTBALL_DATA_API_KEY=your-football-data-api-key-here

# ─── Cron ──────────────────────────────────────────────────────────────────────
# Random secret (≥32 chars). Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
# Must be set identically in both: this .env.local AND Vercel project env vars
# SERVER ONLY
CRON_SECRET=your-random-secret-minimum-32-characters-here

